# AskDUNE environment configuration
# Copy to .env and configure for your environment.
# Never commit real credentials or private session tokens.

# LLM provider: argo or fermilab
LLM_PROVIDER=argo
LLM_MODEL=gpt4o

# Argonne Argo API (required when LLM_PROVIDER=argo)
ARGO_API_USERNAME=your_username_here
ARGO_API_KEY=your_api_key_here
ARGO_API_URL=https://apps.inside.anl.gov/argoapi/api/v1/resource/chat/

# DUNE DocDB credentials
DUNE_DOCDB_USERNAME=your_docdb_username
DUNE_DOCDB_PASSWORD=your_docdb_password
DUNE_DOCDB_API_KEY=your_docdb_api_session_key

# DUNE Indico credentials
DUNE_INDICO_ACCESS_KEY=your_indico_access_key
INDICO_API_TOKEN=your_indico_api_token
INDICO_BASE_URL=https://indico.fnal.gov
INDICO_USE_BROWSER_LOGIN=true

# Fermilab SSO
# Disable authentication only for local development.
ENABLE_AUTHENTICATION=true
FERMILAB_CLIENT_ID=your_fermilab_client_id
FERMILAB_CLIENT_SECRET=your_fermilab_client_secret
FERMILAB_SESSION_SECRET=replace_with_a_long_random_secret
FERMILAB_SCOPE=openid email profile
FERMILAB_REDIRECT_URI=http://127.0.0.1:8000/auth
FERMI_SSO_USERNAME=your_fermilab_sso_username
FERMI_SSO_PASSWORD=your_fermilab_sso_password

# Document processing
DOC_LIMIT_DOCDB=50
DOC_LIMIT_INDICO=50
CHUNK_SIZE=2000

# Unified parent-child retrieval

# ChromaDB used for serving answers.
# Must contain the validated unified DocDB and Indico collections.
PROD_DB_PATH=/path/to/validated/unified/index

# Separate ChromaDB used for indexing.
# Must not be the same directory as PROD_DB_PATH.
INDEXING_DB_PATH=/path/to/development/indexing

# Embedding model must match the model used to build the index.
EMBEDDING_MODEL=intfloat/e5-small-v2

# Cross-encoder used to rerank retrieved candidates.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Number of embedding candidates considered during retrieval.
K_DOCS=30

# Application
# Use 127.0.0.1 for local development.
# Production networking must be configured separately.
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Logging
LOG_LEVEL=INFO

# Query and generation
DEFAULT_TOP_K=3
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
