#!/bin/bash -l
#PBS -N dune_mpnet
#PBS -A LLM_for_DUNE
#PBS -l select=1
#PBS -l walltime=04:00:00
#PBS -l filesystems=home:flare
#PBS -o benchmarking/matrix_runs/aurora_full_mpnet/pbs_stdout.log
#PBS -e benchmarking/matrix_runs/aurora_full_mpnet/pbs_stderr.log

cd /lus/flare/projects/LLM_for_DUNE/users/peilin/dunegpt || exit 1

module load python/3.12.12
source venv/bin/activate

export HF_HOME="$PWD/.hf_cache"
export SENTENCE_TRANSFORMERS_HOME="$PWD/.sentence_transformers_cache"

mkdir -p benchmarking/matrix_runs/aurora_full_mpnet

python benchmarking/scripts/run_embedding_matrix.py \
  --run-name aurora_full_mpnet \
  --source both \
  --models sentence-transformers/multi-qa-mpnet-base-dot-v1 \
  --chunk-sizes 1000,2000 \
  --chunk-overlaps 0,100,200 \
  --skip-completed
